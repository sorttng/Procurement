<mah:MetroWindow x:Class="Signet.View.GoodsManage_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Signet.View"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        mc:Ignorable="d" 
        xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:ui ="clr-namespace:Signet.UI"
        xmlns:mvvm="http://www.galasoft.ch/mvvmlight"
        xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
        Dialog:DialogParticipation.Register="{Binding}"
        xmlns:c="clr-namespace:Signet.Common"
        Title="{Binding mGoodsManage_Model.Header, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Height="450" Width="800">
    <i:Interaction.Behaviors>
        <c:WindowBehavior Close="{Binding ToClose}"/>
    </i:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60*"></RowDefinition>

            <RowDefinition Height="100*"></RowDefinition>
            <RowDefinition Height="100*"></RowDefinition>
            <RowDefinition Height="100*"></RowDefinition>

            <RowDefinition Height="100*"></RowDefinition>

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="50*"></ColumnDefinition>

            <ColumnDefinition Width="60*"></ColumnDefinition>
            <ColumnDefinition Width="100*"></ColumnDefinition>

            <ColumnDefinition Width="30*"></ColumnDefinition>

            <ColumnDefinition Width="60*"></ColumnDefinition>
            <ColumnDefinition Width="100*"></ColumnDefinition>

            <ColumnDefinition Width="50*"></ColumnDefinition>

        </Grid.ColumnDefinitions>


        <Label Grid.Column="1" Grid.Row="1"
               VerticalAlignment="Center" HorizontalAlignment="Right">物品编码:</Label>
        <TextBox Grid.Column="2" Grid.Row="1" 
                 Width="150" Height="30" IsReadOnly="True" IsEnabled="False"
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 mah:ValidationHelper.AlwaysShowValidationError="False"
                 mah:ValidationHelper.ShowValidationErrorOnKeyboardFocus="True"
                 mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                 mah:ValidationHelper.CloseOnMouseLeftButtonDown="True"
                 Text="{Binding mGoodsManage_Model.GoodsCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>

        <Label Grid.Column="4" Grid.Row="1"
               VerticalAlignment="Center" HorizontalAlignment="Right">物品名称:</Label>
        <TextBox Grid.Column="5" Grid.Row="1" 
                 Width="150" Height="30"
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 mah:ValidationHelper.AlwaysShowValidationError="False"
                 mah:ValidationHelper.ShowValidationErrorOnKeyboardFocus="True"
                 mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                 mah:ValidationHelper.CloseOnMouseLeftButtonDown="True"
                 Text="{Binding mGoodsManage_Model.GoodsName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"></TextBox>

        <Label Grid.Column="1" Grid.Row="2"
               VerticalAlignment="Center" HorizontalAlignment="Right">物品型号:</Label>
        <TextBox Grid.Column="2" Grid.Row="2" 
                 Width="150" Height="30"
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 mah:ValidationHelper.AlwaysShowValidationError="False"
                 mah:ValidationHelper.ShowValidationErrorOnKeyboardFocus="True"
                 mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                 mah:ValidationHelper.CloseOnMouseLeftButtonDown="True"
                 Text="{Binding mGoodsManage_Model.GoodsModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"></TextBox>


        <Label Grid.Column="4" Grid.Row="2"
               VerticalAlignment="Center" HorizontalAlignment="Right">物资类型:</Label>
        <ComboBox Grid.Column="5" Grid.Row="2" 
                 Width="150" Height="30"
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                mah:ValidationHelper.AlwaysShowValidationError="False"
                mah:ValidationHelper.ShowValidationErrorOnKeyboardFocus="True"
                mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                mah:ValidationHelper.CloseOnMouseLeftButtonDown="True"                  
                 ItemsSource="{Binding mGoodsManage_Model.GoodsTypeList,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                 SelectedItem="{Binding mGoodsManage_Model.SelectedGoodsType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                 DisplayMemberPath="GoodsType_Name" SelectedValuePath="GoodsType_ID"></ComboBox>

        <Label Grid.Column="1" Grid.Row="3"
               VerticalAlignment="Center" HorizontalAlignment="Right">分类:</Label>
        <ComboBox Grid.Column="2" Grid.Row="3" 
                 Width="150" Height="30"
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 mah:ValidationHelper.AlwaysShowValidationError="False"
                 mah:ValidationHelper.ShowValidationErrorOnKeyboardFocus="True"
                 mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                 mah:ValidationHelper.CloseOnMouseLeftButtonDown="True"
                 ItemsSource="{Binding mGoodsManage_Model.ClassificationList,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                 SelectedItem="{Binding mGoodsManage_Model.SelectedClassification,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                 DisplayMemberPath="Classification_Name" SelectedValuePath="Classification_ID"></ComboBox>

        <Label Grid.Column="4" Grid.Row="3"
               VerticalAlignment="Center" HorizontalAlignment="Right">单位:</Label>
        <ComboBox Grid.Column="5" Grid.Row="3" 
                 Width="150" Height="30"
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 mah:ValidationHelper.AlwaysShowValidationError="False"
                 mah:ValidationHelper.ShowValidationErrorOnKeyboardFocus="True"
                 mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                 mah:ValidationHelper.CloseOnMouseLeftButtonDown="True"
                 
                 ItemsSource="{Binding mGoodsManage_Model.UnitList,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                 SelectedItem="{Binding mGoodsManage_Model.SelectedUnit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                 DisplayMemberPath="Unit_Name" SelectedValuePath="Unit_"></ComboBox>


        <Button Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2"
                Width="100" Height="30"
            Style="{StaticResource HeadButtonStyle}" Content="确认" >
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                    <i:InvokeCommandAction Command="{Binding Confirm_Command}">
                    </i:InvokeCommandAction>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Button>

        <Button Grid.Column="4" Grid.Row="4" Grid.ColumnSpan="2"
                Width="100" Height="30"
            Style="{StaticResource HeadButtonStyle}" Background="Gray"  Content="取消" >
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                    <i:InvokeCommandAction Command="{Binding Cancel_Command}">
                    </i:InvokeCommandAction>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Button>
    </Grid>
</mah:MetroWindow>
