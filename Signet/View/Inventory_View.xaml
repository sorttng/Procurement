<Page x:Class="Signet.View.Inventory_View"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Signet.View"
      mc:Ignorable="d" 
      xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:ui ="clr-namespace:Signet.UI"
      xmlns:mvvm="http://www.galasoft.ch/mvvmlight"
      xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
      Dialog:DialogParticipation.Register="{Binding}"
      xmlns:c="clr-namespace:Signet.Common"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Inventory_View">
    <Page.DataContext>
        <Binding Path="Inventory" Source="{StaticResource Locator}"></Binding>
    </Page.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="100*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid>
                <!--<Grid.RowDefinitions>
                    <RowDefinition Height="50*"></RowDefinition>
                    <RowDefinition Height="50*"></RowDefinition>
                </Grid.RowDefinitions>-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>

                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>

                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>

                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>

                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">物品名称:</Label>
                <TextBox Grid.Row="0" Grid.Column="1" Width="180" Height=" 35" Margin="10,5,5,5" 
                         mah:TextBoxHelper.Watermark ="请输入物品名称关键词" VerticalContentAlignment="Center"
                         Text="{Binding mInventory_Model.GoodsNameQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                <Label Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">物品型号:</Label>
                <TextBox Grid.Row="0" Grid.Column="3" Width="180" Height=" 35" Margin="10,5,5,5" 
                         mah:TextBoxHelper.Watermark ="请输入物品型号关键词" VerticalContentAlignment="Center"
                         Text="{Binding mInventory_Model.GoodsModleQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>

                <Label Grid.Row="0" Grid.Column="4" VerticalAlignment="Center">物资类型:</Label>
                <mah:MultiSelectionComboBox Grid.Row="0" Grid.Column="5"
                    Width="180" Height="35" Margin="10,0,0,0"
                        SelectedItemContainerStyle="{StaticResource MahApps.Styles.MultiSelectionComboBoxSelectedItem.Removable}"
                        ItemsSource="{Binding mInventory_Model.GoodsTypeList,UpdateSourceTrigger=PropertyChanged}"    
                        mah:MultiSelectorHelper.SelectedItems="{Binding mInventory_Model.SelectedGoodsTypeList, UpdateSourceTrigger=PropertyChanged}"
                        DisplayMemberPath="GoodsType_Name" SelectedValuePath="GoodsType_ID"                       
                        Separator=","
                        SelectionMode="Multiple"
                        IsEditable="True"
                        mah:TextBoxHelper.ClearTextButton="True"                                        
                        mah:TextBoxHelper.Watermark="请选择物资类型">
                </mah:MultiSelectionComboBox>

                <Label Grid.Row="0" Grid.Column="6" VerticalAlignment="Center">分类:</Label>
                <mah:MultiSelectionComboBox Grid.Row="1" Grid.Column="7"
                    Width="180" Height="35" Margin="10,0,0,0"
                       SelectedItemContainerStyle="{StaticResource MahApps.Styles.MultiSelectionComboBoxSelectedItem.Removable}"
                       ItemsSource="{Binding mInventory_Model.ClassificationList,UpdateSourceTrigger=PropertyChanged}"    
                       mah:MultiSelectorHelper.SelectedItems="{Binding mInventory_Model.SelectedClassificationList, UpdateSourceTrigger=PropertyChanged}"
                       DisplayMemberPath="Classification_Name" SelectedValuePath="Classification_ID"                       
                       Separator=","
                       SelectionMode="Multiple"
                       IsEditable="True"
                       mah:TextBoxHelper.ClearTextButton="True"                                        
                       mah:TextBoxHelper.Watermark="请选择分类">
                </mah:MultiSelectionComboBox>

                <Button Grid.Row="0" Grid.Column="8"
                    Style="{StaticResource HeadButtonStyle}" Content="查 询"
                        IsEnabled="{Binding Source={x:Static c:AuthorizationManager.Instance},Path=[UserQuery]}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                            <i:InvokeCommandAction Command="{Binding Search_Command}">
                            </i:InvokeCommandAction>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Button>
            </Grid>

            <!--<StackPanel Grid.Column="0" Orientation="Horizontal">
                -->
            <!--<Label>物品型号:</Label>
                <TextBox Width="200" Height=" 35" Margin="20,5,5,5" 
                         mah:TextBoxHelper.Watermark ="模糊查询请输入关键词" VerticalContentAlignment="Center"
                         Text="{Binding mUsers_Model.QueryConditions,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></TextBox>-->
            <!--
            </StackPanel>-->
        </Grid>

        <DataGrid Grid.Row="1" 
                ItemsSource="{Binding mInventory_Model.GoodsList,Mode=OneWay,UpdateSourceTrigger=PropertyChanged}"
                AutoGenerateColumns="False" CanUserAddRows="False" VerticalScrollBarVisibility="Auto"                                      
                CanUserSortColumns="False" IsReadOnly ="True"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                ScrollViewer.HorizontalScrollBarVisibility="Visible">
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Binding="{Binding SerialNum}" Width="auto" />
                <DataGridTextColumn Header="物品编码" Binding="{Binding Goods_Code}" Width="*" />
                <DataGridTextColumn Header="物品名称" Binding="{Binding Goods_Name}" Width="*" />
                <DataGridTextColumn Header="物品型号" Binding="{Binding Goods_Model}" Width="*" />
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*" />
                <DataGridTextColumn Header="物资类型" Binding="{Binding GoodsType}" Width="*" />
                <DataGridTextColumn Header="分类" Binding="{Binding Classification}" Width="*" />
                <DataGridTextColumn Header="库存" Binding="{Binding Inventory}" Width="*" />
                <DataGridTemplateColumn Header="操作" Width="*" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource DatagridButtonStyle }" Background="Green"
                                        IsEnabled="{Binding Source={x:Static c:AuthorizationManager.Instance},Path=[StockIn]}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding DataContext.StockIn_Command, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding Goods_ID}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                        <TextBlock>入库</TextBlock>
                                        <!--<iconPacks:PackIconBoxIcons VerticalAlignment="Center"  Kind="RegularEditAlt"  Width="12"/>-->
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource DatagridButtonStyle }" Background="Red"
                                        IsEnabled="{Binding Source={x:Static c:AuthorizationManager.Instance},Path=[StockOut]}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding DataContext.StockOut_Command, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"
                                                                               CommandParameter="{Binding Goods_ID}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                        <TextBlock>出库</TextBlock>
                                        <!--<iconPacks:PackIconBoxIcons VerticalAlignment="Center"  Kind="RegularTrash" Width="12"/>-->
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页控件 -->
        <ui:PagerControl Grid.Row="2"
            TotalItems="{Binding TotalItems}"
            CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
            PageSize ="{Binding PageSize, Mode=TwoWay}"/>

    </Grid>

</Page>
