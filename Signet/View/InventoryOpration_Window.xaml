<mah:MetroWindow x:Class="Signet.View.InventoryOpration_Window"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Signet.View"
      mc:Ignorable="d" 
      xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:ui ="clr-namespace:Signet.UI"
      xmlns:mvvm="http://www.galasoft.ch/mvvmlight"
      xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
      xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
      Dialog:DialogParticipation.Register="{Binding}"
      xmlns:c="clr-namespace:Signet.Common"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{Binding mInventoryOperation_Model.Header, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
    <i:Interaction.Behaviors>
        <c:WindowBehavior Close="{Binding ToClose}"/>
    </i:Interaction.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"></RowDefinition>
            <RowDefinition Height="30*"></RowDefinition>
            <RowDefinition Height="40*"></RowDefinition>
            <RowDefinition Height="50*"></RowDefinition>
            <RowDefinition Height="30*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*"></ColumnDefinition>
            <ColumnDefinition Width="10*"></ColumnDefinition>
            <ColumnDefinition Width="10*"></ColumnDefinition>
            <ColumnDefinition Width="50*"></ColumnDefinition>
            <ColumnDefinition Width="20*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="1" Grid.Column="1"
               VerticalAlignment="Center" HorizontalAlignment="Right">出/入库时间</Label>
        <mah:DateTimePicker Grid.Row="1" Grid.Column="3"
            Height="35" VerticalContentAlignment="Center"
                    Culture="zh-cn" mah:TextBoxHelper.Watermark="请选择时间"
                mah:ValidationHelper.AlwaysShowValidationError="False"
                 mah:ValidationHelper.ShowValidationErrorOnKeyboardFocus="True"
                 mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                 mah:ValidationHelper.CloseOnMouseLeftButtonDown="True"
                    SelectedDateTime="{Binding mInventoryOperation_Model.UserTime, Mode=TwoWay, UpdateSourceTrigger=Explicit, ValidatesOnDataErrors=True}"></mah:DateTimePicker>

        <Label Grid.Row="2" Grid.Column="1"
               VerticalAlignment="Center" HorizontalAlignment="Right">数量</Label>
        <mah:NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0"
                mah:ValidationHelper.AlwaysShowValidationError="False"
                 mah:ValidationHelper.ShowValidationErrorOnKeyboardFocus="True"
                 mah:ValidationHelper.ShowValidationErrorOnMouseOver="True"
                 mah:ValidationHelper.CloseOnMouseLeftButtonDown="True"
                           Value="{Binding mInventoryOperation_Model.Num,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
            Height="35" VerticalContentAlignment="Center"></mah:NumericUpDown>

        <Label Grid.Row="3" Grid.Column="1"
               VerticalAlignment="Center" HorizontalAlignment="Right">备注</Label>
        <RichTextBox Grid.Row="3" Grid.Column="3"
                             mah:TextBoxHelper.ClearTextButton="True"
                             mah:TextBoxHelper.Watermark="输入备注..."
                             IsDocumentEnabled="True"
                             SpellCheck.IsEnabled="True">
            <FlowDocument PageWidth="NaN">
                <Paragraph>
                    <Run Text="{Binding mInventoryOperation_Model.Remark,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Run>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="5">
            <Button
                Width="100" Height="35" Margin="0,0,150,0"
            Style="{StaticResource HeadButtonStyle}" Content="确认" >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction Command="{Binding Confirm_Command}">
                        </i:InvokeCommandAction>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>

            <Button 
                Width="100" Height="35" Margin="150,0,0,0"
            Style="{StaticResource HeadButtonStyle}" Background="Gray"  Content="取消" >
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction Command="{Binding Cancel_Command}">
                        </i:InvokeCommandAction>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>

        </StackPanel>
        
    </Grid>
</mah:MetroWindow>
